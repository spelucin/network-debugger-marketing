    "*://stats.g.doubleclick.net/*",
    "*://*.facebook.com/*",
    "*://*.facebook.net/*",
    "*://connect.facebook.net/*",
    "*://connect.facebook.com/*",
    "*://analytics.tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://events.tiktok.com/*",
    "*://analytics-sg.tiktok.com/*",
    "*://an.tiktok.com/*",
    "*://analytics-ipv6.tiktokw.us/*",
    "*://*.tiktokw.us/*",
    "*://*.clarity.ms/*",
    "*://px.ads.linkedin.com/*",
    "*://linkedin.com/*",
    "*://snap.licdn.com/*",
    "*://ct.pinterest.com/*",
    "*://pinterest.com/*",
    "*://log.pinterest.com/*",
    "*://s.pinimg.com/*",
    "*://ads.reddit.com/*",
    "*://alb.reddit.com/*",
    "*://redditmedia.com/*",
    "*://pixel-config.reddit.com/*",
    "*://www.redditstatic.com/*",
    "*://static.ads-twitter.com/*",
    "*://analytics.twitter.com/*",
    "*://t.co/*",
    "*://tr.snapchat.com/*",
    "*://tr6.snapchat.com/*",
    "*://sc-static.net/*",
    "*://gcp.api.snapchat.com/*",
    "*://api.amplitude.com/*",
