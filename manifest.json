    "*://api.eu.amplitude.com/*",
    "*://analytics.amplitude.com/*",
    "*://cdn.amplitude.com/*",
    "*://api.mixpanel.com/*",
    "*://api-eu.mixpanel.com/*",
    "*://api-in.mixpanel.com/*",
    "*://decide.mixpanel.com/*",
    "*://api-js.mixpanel.com/*",
    "*://cdn.mxpnl.com/*",
    "*://mxpnl.com/*",
    "*://*.2o7.net/*",
    "*://*.sc.omtrdc.net/*",
    "*://omniture.com/*",
    "*://*.tt.omtrdc.net/*",
    "*://demdex.net/*",
    "*://dpm.demdex.net/*",
    "*://dcs.demdex.net/*",
    "*://fast.demdex.net/*",
    "*://edge.adobedc.net/*",
    "*://server.adobedc.net/*",
    "*://*.adobedc.net/*",
    "*://assets.adobedtm.com/*",
    "*://launch.adobe.com/*",
    "*://everesttech.net/*",
    "*://pixel.everesttech.net/*",
    "*://api.segment.io/*",
    "*://api.segment.com/*",
    "*://cdn.segment.io/*",
    "*://cdn.segment.com/*",
    "*://events.segment.io/*",
    "*://events.segment.com/*",
    "*://collect.tealiumiq.com/*",
    "*://tags.tiqcdn.com/*",
    "*://*.heapanalytics.com/*",
    "*://cdn.heapanalytics.com/*",
    "*://track.heap.io/*",
    "*://api.heap.io/*",
    "*://c.us.heap-api.com/*",
    "*://c.eu.heap-api.com/*",
    "*://static.criteo.net/*",
    "*://dis.criteo.com/*",
    "*://sslwidget.criteo.com/*",
    "*://bidder.criteo.com/*",
    "*://gum.criteo.com/*",
    "*://rtax.criteo.com/*",
    "*://cat.criteo.com/*",
    "*://dynamic.criteo.com/*",
    "*://bat.bing.com/*",
    "*://bat.r.msn.com/*",
